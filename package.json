{
  "name": "hr-platform",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "bot"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\" \"npm run dev -w bot\"",
    "build": "npm run build -w web && npm run build -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "admin:reset": "npm run admin:reset -w server",
    "test:smoke": "npm run test:smoke -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
